mainmenu "MC UART sample"

source "Kconfig.zephyr"

choice MC_UART_ROLE
	prompt "MC UART role"
	default MC_UART_SENDER
	help
	  Select whether this board transmits or receives the MC UART test
	  sequence. Build the same application with a different role on the
	  second board.

config MC_UART_SENDER
	bool "Sender"
	help
	  Send the MC message and signal test sequence.

config MC_UART_RECEIVER
	bool "Receiver"
	help
	  Receive and validate the MC message and signal test sequence.

endchoice
